FROM node:20-alpine AS builder
WORKDIR /app
# pnpm workspace root — must see apps/web BEFORE install so web's deps get resolved
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY apps/web ./apps/web
RUN corepack enable && pnpm install --frozen-lockfile
# Next 16 standalone: server at <root>/apps/web/server.js, but with pnpm hoisted
# linking the traced node_modules lands at <root>/node_modules (sibling of apps/).
RUN pnpm --dir apps/web build

FROM node:20-alpine
WORKDIR /app
# copy the standalone app AND its sibling node_modules (both under <root>)
COPY --from=builder /app/apps/web/.next/standalone/apps/web ./
COPY --from=builder /app/apps/web/.next/standalone/node_modules ./node_modules
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
ENV PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["node", "server.js"]