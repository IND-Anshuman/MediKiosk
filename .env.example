# MediKiosk — environment variables (copy to .env and fill in)
# DO NOT commit .env — it is gitignored.

# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medikiosk:medikiosk@localhost:5432/medikiosk
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
CORS_ALLOW=*

# ─── LLM (dialogue slot-filler + summarizer) ─────────────────────────────────
# One OpenAI-compatible config for ANY provider:
#   OPENAI_API_KEY  = credential
#   OPENAI_BASE_URL = endpoint; OMIT for api.openai.com. Set to your provider:
#                       Featherless https://api.featherless.ai/v1
#                       Groq        https://api.groq.com/openai/v1
#                       Together    https://api.together.xyz/v1
#                       local vLLM  http://localhost:8000/v1
#   OPENAI_MODEL    = model id, e.g. gpt-4o-mini, zai-org/glm-5.3-flash
# To actually use a live model the dialogue/summarizer services must also see
# LLM_BACKEND=openai (default "stub" = deterministic, offline, no key).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_BACKEND=stub
# For local Llama via llama-cpp-python:
# LLM_BACKEND=local
# LLM_MODEL_PATH=models/llama-3.1-8B.Q4_K_M.gguf

# ─── Languages / ASR-TTS ─────────────────────────────────────────────────────
# LANG_BACKEND=local|bhashini|edge (default local = faster-whisper on CPU,
#   English+Hindi + pre-baked edge-tts). bhashini = 22 Indian languages via ULCA.
LANG_BACKEND=local
# Bhashini / ULCA (org key + pipeline ids from https://ulca.bhashini.gov.in)
BHASHINI_ULCA_API_KEY=
BHASHINI_ASR_PIPELINE_ID=
BHASHINI_TTS_PIPELINE_ID=
BHASHINI_NMT_PIPELINE_ID=

# ─── ASR backend ─────────────────────────────────────────────────────────────
# local (default, faster-whisper, needs no key) | speechmatics (external API,
#   multilingual, NO local model) | bhashini
ASR_BACKEND=local
SPEECHMATICS_API_KEY=

# ─── OCR backend ────────────────────────────────────────────────────────────
# vision (recommended: API-only via an OpenAI-compatible vision model —
#   Featherless base URL + key; NO local model, slimmest container) |
# paddle (local PaddleOCR, Linux/Docker-only, heavy ~1GB)
OCR_BACKEND=vision

# ─── ABDM / ABHA ─────────────────────────────────────────────────────────────
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIU_ID=
ABDM_HIP_ID=
# ABDM_MODE=sandbox|production (default sandbox)
ABDM_MODE=sandbox

# ─── PM-JAY / NHA ────────────────────────────────────────────────────────────
# Empanelled-hospital credential for read-only eligibility check.
# Leave blank for guide-mode fallback.
PMJAY_HOSPITAL_ID=
PMJAY_API_KEY=
PMJAY_STATE_PACK=

# ─── HIS / FHIR ──────────────────────────────────────────────────────────────
HIS_FHIR_URL=
# When blank, bundles are logged to data/fhir-outbox/

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Model download cache (mirror blocked HuggingFace downloads) ─────────────
# HF_HOME=/path/to/models